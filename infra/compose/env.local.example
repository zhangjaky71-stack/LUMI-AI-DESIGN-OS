# LOCAL_ONLY — copied automatically to infra/compose/.env by `make infra-up`.
# Never reuse these credentials in staging or production.
COMPOSE_PROJECT_NAME=lumi

POSTGRES_IMAGE=pgvector/pgvector:0.8.6-pg17-bookworm
POSTGRES_DB=lumi
POSTGRES_SUPERUSER=lumi_admin
POSTGRES_SUPERUSER_PASSWORD=lumi_admin_local_only
POSTGRES_APP_USER=lumi_app
POSTGRES_APP_PASSWORD=lumi_app_local_only
POSTGRES_MIGRATION_USER=lumi_migration
POSTGRES_MIGRATION_PASSWORD=lumi_migration_local_only
POSTGRES_PORT=5432

REDIS_IMAGE=redis:7.4-alpine
REDIS_PASSWORD=lumi_redis_local_only
REDIS_PORT=6379

RABBITMQ_IMAGE=rabbitmq:4.1.8-management-alpine
RABBITMQ_DEFAULT_USER=lumi
RABBITMQ_DEFAULT_PASS=lumi_rabbit_local_only
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-06T17-38-46Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
MINIO_ROOT_USER=lumi-local
MINIO_ROOT_PASSWORD=lumi_minio_local_only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_ASSETS=lumi-assets
MINIO_BUCKET_EXPORTS=lumi-exports
MINIO_BUCKET_SANDBOX=lumi-sandbox

MAILPIT_IMAGE=axllent/mailpit:v1.30.0
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
