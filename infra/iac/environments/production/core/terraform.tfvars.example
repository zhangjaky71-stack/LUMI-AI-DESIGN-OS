account_id             = "123456789012"
region                 = "ap-northeast-1"
availability_zones     = ["ap-northeast-1a", "ap-northeast-1c", "ap-northeast-1d"]
postgres_engine_version = "REPLACE_WITH_REGION_VALIDATED_PIN"
redis_engine_version    = "REPLACE_WITH_REGION_VALIDATED_PIN"
rabbitmq_engine_version = "REPLACE_WITH_REGION_VALIDATED_PIN"
rabbitmq_instance_type  = "REPLACE_WITH_REGION_VALIDATED_MULTI_AZ_INSTANCE_TYPE"

# Inject only from the protected production deployment environment:
# TF_VAR_redis_auth_token
# TF_VAR_rabbitmq_username
# TF_VAR_rabbitmq_password
