account_id              = "123456789012"
region                  = "ap-northeast-1"
availability_zones      = ["ap-northeast-1a", "ap-northeast-1c", "ap-northeast-1d"]
postgres_engine_version = "REPLACE_WITH_REGION_VALIDATED_PIN"
redis_engine_version    = "REPLACE_WITH_REGION_VALIDATED_PIN"
rabbitmq_engine_version = "REPLACE_WITH_REGION_VALIDATED_PIN"
rabbitmq_instance_type  = "REPLACE_WITH_REGION_VALIDATED_INSTANCE_TYPE"

# Staging Redis AUTH and the initial RabbitMQ admin credential are generated by
# Terraform and persisted only in the KMS-encrypted/versioned Terraform state.
# Their runtime connection URLs are written into the existing Secrets Manager
# containers by the Staging core root; do not add CI plaintext credential vars.
