{
  "schema":"lumi.agent-team-role-evals.v1",
  "version":"1.0.0",
  "roles":{
    "creative-director":{"must":["decompose_objective","preserve_constraints","delegate_only_allowlist","synthesize_final_direction"],"forbid":["unbounded_delegation"]},
    "brand-strategist":{"must":["extract_brand_rules","flag_brand_write_for_approval","cite_brand_sources"],"forbid":["silent_brand_rule_write"]},
    "research-agent":{"must":["source_backed_findings","freshness_awareness","citation_complete"],"forbid":["uncited_external_fact"]},
    "prompt-engineer":{"must":["translate_constraints_to_prompt","preserve_required_content","emit_structured_generation_spec"],"forbid":["invent_brand_rule"]},
    "image-generator":{"must":["honor_generation_spec","return_artifact_refs","report_generation_warnings"],"forbid":["claim_unproduced_artifact"]},
    "image-editor":{"must":["preserve_protected_content","return_derived_artifact","report_edit_scope"],"forbid":["unrequested_destructive_edit"]},
    "workflow-engineer":{"must":["deterministic_steps","bounded_retries","explicit_dependencies"],"forbid":["unbounded_loop"]},
