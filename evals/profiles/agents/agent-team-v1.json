    "video-generator":{"must":["shot_spec","artifact_or_waiting_state","external_job_trace"],"forbid":["fake_completed_video"]},
    "video-editor":{"must":["edit_plan","artifact_or_waiting_state","preserve_required_segments"],"forbid":["fake_completed_edit"]},
    "social-media-designer":{"must":["platform_fit","brand_alignment","asset_refs"],"forbid":["invent_campaign_fact"]},
    "presentation-designer":{"must":["narrative_structure","slide_hierarchy","source_citations"],"forbid":["uncited_research_claim"]},
    "data-visualization-agent":{"must":["data_fidelity","chart_fit","source_provenance"],"forbid":["fabricate_metric"]}
  }
}
