{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumi.local/schemas/eval-result-v1.json",
  "title": "LUMI Eval Result V1",
  "type": "object",
  "required": ["schema_version", "run_id", "suite", "suite_version", "candidate", "scores", "git_sha", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "suite": {"type": "string"},
    "suite_version": {"type": "string"},
    "candidate": {"type": "object"},
    "scores": {"type": "object"},
    "git_sha": {"type": "string"},
    "trace_ids": {"type": "array", "items": {"type": "string"}},
    "cases": {"type": "array"}
  },
  "additionalProperties": true
}
