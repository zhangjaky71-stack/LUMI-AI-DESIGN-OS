{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumi.local/schemas/eval-case-v1.json",
  "title": "LUMI Eval Case V1",
  "type": "object",
  "required": ["id", "suite", "version", "input", "expected", "metrics", "grader"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "suite": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "input": {"type": "object"},
    "expected": {"type": "object"},
    "metrics": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "grader": {
      "type": "object",
      "required": ["checks"],
      "properties": {
        "checks": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      }
    }
  },
  "additionalProperties": true
}
