{
  "name": "auto-repair",
  "version": "1.0.0",
  "primary_metric": "task_success",
  "metrics": {
    "task_success": {"aggregation": "mean", "direction": "higher"},
    "unsafe_branch_overwrite": {"aggregation": "sum", "direction": "lower"},
    "paid_without_reservation": {"aggregation": "sum", "direction": "lower"},
    "loop_bound_exceeded": {"aggregation": "sum", "direction": "lower"},
    "cost_usd": {"aggregation": "p95", "direction": "lower"},
    "latency_ms": {"aggregation": "p95", "direction": "lower"}
  },
  "gate": {
    "primary": {"metric": "task_success", "max_regression": 0.0},
    "guardrails": [
      {"metric": "unsafe_branch_overwrite", "comparison": "max_absolute", "value": 0},
      {"metric": "paid_without_reservation", "comparison": "max_absolute", "value": 0},
      {"metric": "loop_bound_exceeded", "comparison": "max_absolute", "value": 0},
      {"metric": "cost_usd", "comparison": "max_ratio", "value": 1.2},
      {"metric": "latency_ms", "comparison": "max_ratio", "value": 1.2}
    ]
  }
}
