# LUMI runtime
LUMI_ENV=development
LUMI_LOG_LEVEL=INFO
LUMI_VERSION=0.0.0-dev

# Local infrastructure. Values below are LOCAL_ONLY examples and must never be reused in staging/prod.
DATABASE_URL=postgresql+asyncpg://lumi_app:lumi_app_local_only@localhost:5432/lumi
MIGRATION_DATABASE_URL=postgresql+asyncpg://lumi_migration:lumi_migration_local_only@localhost:5432/lumi
REDIS_URL=redis://:lumi_redis_local_only@localhost:6379/0
RABBITMQ_URL=amqp://lumi:lumi_rabbit_local_only@localhost:5672//
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=lumi-assets
S3_ACCESS_KEY_ID=lumi-local
S3_SECRET_ACCESS_KEY=lumi_minio_local_only
MAILPIT_SMTP_URL=smtp://localhost:1025
MAILPIT_HTTP_URL=http://localhost:8025

# Optional observability. Never commit a real key.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=lumi-local

# Frontend public configuration (safe for browser exposure only)
NEXT_PUBLIC_LUMI_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
