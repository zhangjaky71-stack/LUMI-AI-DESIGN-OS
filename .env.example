# LUMI runtime
LUMI_ENV=development
LUMI_LOG_LEVEL=INFO
LUMI_VERSION=0.0.0-dev

# Local infrastructure (NODE-03 will make these required for dependent services)
DATABASE_URL=postgresql+psycopg://lumi:lumi@localhost:5432/lumi
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://lumi:lumi@localhost:5672//
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=lumi-local
S3_ACCESS_KEY_ID=lumi-local
S3_SECRET_ACCESS_KEY=lumi-local-only

# Optional observability. Never commit a real key.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=lumi-local

# Frontend public configuration (safe for browser exposure only)
NEXT_PUBLIC_LUMI_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
