{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lumi.agent-output.TeamTaskResult.v1",
  "title": "TeamTaskResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "artifacts", "citations", "confidence", "warnings", "followups", "structured_output"],
  "properties": {
    "status": {"type":"string","enum":["SUCCEEDED","FAILED_RETRYABLE","FAILED_FINAL","WAITING_EXTERNAL","WAITING_APPROVAL","CANCELLED"]},
    "summary": {"type":"string","minLength":1},
    "artifacts": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["artifact_id","version","kind"],"properties":{"artifact_id":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"kind":{"type":"string","minLength":1}}}},
    "citations": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["source_type","source_id","version","locator"],"properties":{"source_type":{"type":"string","minLength":1},"source_id":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"locator":{"type":"object"}}}},
    "confidence": {"type":"number","minimum":0,"maximum":1},
    "warnings": {"type":"array","items":{"type":"string"}},
    "followups": {"type":"array","items":{"type":"string"}},
    "waiting_reason": {"type":["string","null"]},
    "structured_output": {"type":"object"}
  }
}
