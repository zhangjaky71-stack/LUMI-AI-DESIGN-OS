{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lumi.dev/constraints/v1/constraint.schema.json",
  "title": "LUMI Constraint V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "scope", "severity", "source", "priority", "parameters", "active"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 160},
    "type": {"enum": ["LOCK_POSITION","LOCK_SIZE","LOCK_ROTATION","LOCK_TRANSFORM","LOCK_ASPECT_RATIO","LOCK_LAYER_ORDER","LOCK_PARENT","LOCK_CONTENT","LOCK_TEXT","LOCK_ASSET","LOCK_IDENTITY","LOCK_STYLE","LOCK_BRAND","PROTECT_REGION","MUST_STAY_INSIDE","MUST_NOT_OVERLAP","MIN_MARGIN","SAFE_AREA","REQUIRE_CONTRAST","REQUIRE_SCANNABILITY","REQUIRE_TEXT_READABILITY","REQUIRE_BRAND_COMPLIANCE","REQUIRE_RESOLUTION","REQUIRE_IDENTITY_SCORE"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "node_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "roles": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "frame_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "region": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height", "normalized"],
          "properties": {
            "x": {"type": "number"},
            "y": {"type": "number"},
            "width": {"type": "number", "minimum": 0},
            "height": {"type": "number", "minimum": 0},
            "normalized": {"type": "boolean"}
          }
        }
      }
    },
    "severity": {"enum": ["HARD", "SOFT", "ADVISORY"]},
    "source": {"enum": ["SAFETY_SYSTEM","USER_EXPLICIT","APPROVED_BRAND_RULE","PROJECT_RULE","RECIPE_RULE","AGENT_INFERRED","STYLE_PREFERENCE"]},
    "priority": {"type": "integer", "minimum": 0, "maximum": 10000},
    "parameters": {"type": "object", "additionalProperties": true},
    "active": {"type": "boolean"},
    "override_policy": {"enum": ["NEVER", "AUTHORIZED"], "default": "AUTHORIZED"},
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instruction_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "agent_run_id": {"type": "string"},
        "rule_version": {"type": "string"}
      }
    }
  }
}
