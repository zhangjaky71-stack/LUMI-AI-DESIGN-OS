{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lumi:event:generation.completed:1",
  "title": "generation.completed payload v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["generation_id", "project_id", "provider", "model", "capability"],
  "properties": {
    "generation_id": {"type": "string", "format": "uuid"},
    "project_id": {"type": "string", "format": "uuid"},
    "task_id": {"type": ["string", "null"], "format": "uuid"},
    "agent_run_id": {"type": ["string", "null"], "format": "uuid"},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "capability": {"type": "string", "minLength": 1},
    "artifact_version_id": {"type": ["string", "null"], "format": "uuid"}
  }
}
