{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lumi.dev/artifacts/v1/rights.schema.json",
  "title": "LUMI Rights V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject_type","subject_id","organization_id","source_type","owner_assertion","license_type","commercial_use","redistribution","training_use","attribution_required","source_reference","review_status"],
  "properties": {
    "subject_type": {"enum":["ASSET","ARTIFACT_VERSION"]},
    "subject_id": {"type":"string","minLength":1},
    "organization_id": {"type":"string","minLength":1},
    "source_type": {"enum":["USER_UPLOAD","GENERATED","LICENSED","PUBLIC_DOMAIN","THIRD_PARTY","UNKNOWN"]},
    "owner_assertion": {"type":["string","null"],"maxLength":2000},
    "license_type": {"enum":["OWNED","COMMERCIAL_LICENSE","NONCOMMERCIAL","PUBLIC_DOMAIN","CC_BY","CC_BY_SA","UNKNOWN"]},
    "commercial_use": {"enum":["ALLOWED","DENIED","UNKNOWN"]},
    "redistribution": {"enum":["ALLOWED","DENIED","UNKNOWN"]},
    "training_use": {"enum":["ALLOWED","DENIED","UNKNOWN"]},
    "attribution_required": {"type":"boolean"},
    "source_reference": {"type":["string","null"],"maxLength":2048},
    "review_status": {"enum":["UNREVIEWED","ASSERTED","VERIFIED","RESTRICTED"]}
  }
}
