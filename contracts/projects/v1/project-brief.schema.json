{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lumi.dev/projects/v1/project-brief.schema.json",
  "title": "LUMI Project Brief V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "objective",
    "audience",
    "brand_context",
    "deliverables",
    "channels",
    "visual_direction",
    "copy_requirements",
    "constraint_ids",
    "reference_asset_ids",
    "locale",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "objective": {"type": "string", "maxLength": 5000},
    "audience": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "brand_context": {"type": "string", "maxLength": 10000},
    "deliverables": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key","kind","quantity"],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
          "kind": {"type": "string", "minLength": 1, "maxLength": 100},
          "quantity": {"type": "integer", "minimum": 1, "maximum": 1000},
          "width": {"type": ["integer","null"], "minimum": 1, "maximum": 100000},
          "height": {"type": ["integer","null"], "minimum": 1, "maximum": 100000},
          "unit": {"enum": ["px","mm","cm","in","pt",null]},
          "notes": {"type": "string", "maxLength": 2000}
        }
      }
    },
    "channels": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
    "visual_direction": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "copy_requirements": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "constraint_ids": {"type": "array", "maxItems": 500, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
    "reference_asset_ids": {"type": "array", "maxItems": 200, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
    "locale": {"type": "string", "minLength": 1, "maxLength": 64},
    "notes": {"type": "string", "maxLength": 10000}
  }
}
