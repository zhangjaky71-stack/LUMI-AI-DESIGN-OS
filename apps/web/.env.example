# Internal API origin used by Next.js server requests and same-origin /api rewrites.
LUMI_API_ORIGIN=http://localhost:8000

# Override only when the deployed identity API contract uses different endpoints.
LUMI_SESSION_PATH=/api/v1/auth/session
LUMI_SIGN_IN_PATH=/api/v1/auth/login
LUMI_SIGN_OUT_PATH=/api/v1/auth/logout

# Disable Next.js telemetry in CI/production if required by deployment policy.
NEXT_TELEMETRY_DISABLED=1
