{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "@lumi/artifact-sdk": ["../../packages/artifact-sdk/src/index.ts"],
      "@lumi/brand-rules": ["../../packages/brand-rules/src/index.ts"],
      "@lumi/canvas-sdk": ["../../packages/canvas-sdk/src/index.ts"],
      "@lumi/design-ir": ["../../packages/design-ir/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
