#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE_DIR="$ROOT/infra/compose"
ENV_FILE="$COMPOSE_DIR/.env"
BASE_FILE="$COMPOSE_DIR/docker-compose.yml"
OBS_FILE="$COMPOSE_DIR/docker-compose.observability.yml"

if [[ ! -f "$ENV_FILE" ]]; then
  cp "$COMPOSE_DIR/env.local.example" "$ENV_FILE"
fi

compose=(docker compose --env-file "$ENV_FILE" -f "$BASE_FILE" -f "$OBS_FILE")
"${compose[@]}" config --quiet

probe() {
  local name="$1"
  local url="$2"
  local attempts="${3:-30}"
  local delay="${4:-2}"

  for ((i = 1; i <= attempts; i++)); do
    if curl --fail --silent --show-error --max-time 3 "$url" >/dev/null 2>&1; then
      printf 'PASS %-20s %s\n' "$name" "$url"
      return 0
    fi
    sleep "$delay"
  done

  printf 'FAIL %-20s %s\n' "$name" "$url" >&2
  return 1
}

probe "otel-collector" "http://127.0.0.1:${OTEL_HEALTH_PORT:-13133}/"
probe "prometheus" "http://127.0.0.1:${PROMETHEUS_PORT:-9090}/-/ready"
probe "tempo" "http://127.0.0.1:${TEMPO_HTTP_PORT:-3200}/ready"
probe "loki" "http://127.0.0.1:${LOKI_HTTP_PORT:-3100}/ready"
probe "grafana" "http://127.0.0.1:${GRAFANA_PORT:-3001}/api/health"

if [[ -n "${LUMI_API_URL:-}" ]]; then
  probe "lumi-api-metrics" "${LUMI_API_URL%/}/internal/metrics" 10 1
fi

printf 'Observability smoke checks passed.\n'
